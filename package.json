{
  "name": "tickerdeck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "build:app": "next build",
    "migrate": "node --env-file=.env.local scripts/migrate.mjs"
  },
  "dependencies": {
    "@neelsatyavolu/shared-ai-auth": "github:neelsatyavolu/shared-ai-auth#31ac03997710d12a8fcc13def4004132ceb2864d",
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/functions": "^3.9.11",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.4.1",
  "pnpm": {
    "onlyBuiltDependencies": [],
    "ignoredBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neelsatyavolu/tickerdeck.git"
  }
}
