# Neon (set by the Vercel Neon integration)
DATABASE_URL=
NEON_AUTH_BASE_URL=
# Random string, 32+ characters
NEON_AUTH_COOKIE_SECRET=

# Market data: https://finnhub.io (free key works)
FINNHUB_API_KEY=
# Shared Cloudflare price relay: https://<worker>/stream
PRICE_STREAM_URL=
# Same random 32+ character secret on the app and price relay
PRICE_STREAM_SECRET=

# Account emails (password reset, email confirmation): https://resend.com
RESEND_API_KEY=

# Xanom sign-in (accounts.xanom.co). The secret is the tickerquill client's.
XANOM_ISSUER=https://accounts.xanom.co
XANOM_CLIENT_ID=tickerquill
XANOM_CLIENT_SECRET=

# Optional: sync brokerage positions through Plaid (https://dashboard.plaid.com).
# Off unless all four are set. Only PLAID_OWNER_USER_ID (shown in Settings ->
# Account) can link brokerages. PLAID_TOKEN_KEY is a random string of 32+
# characters that encrypts stored access tokens; changing it breaks every link.
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_TOKEN_KEY=
# PLAID_OWNER_USER_ID=
# sandbox (default) or production
# PLAID_ENV=sandbox

# Optional default models for the assistant
# CODEX_MODEL=gpt-6-astra
# GROK_MODEL=grok-4.7
